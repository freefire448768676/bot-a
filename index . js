const { Telegraf, Markup } = require("telegraf");
require("dotenv").config();
const { Pool } = require("pg");

const bot = new Telegraf(process.env.BOT_TOKEN);

// قاعدة بيانات Render PostgreSQL
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false }
});

// انشاء جدول المستخدمين اذا مو موجود
pool.query(`
  CREATE TABLE IF NOT EXISTS users (
    id BIGINT PRIMARY KEY,
    username TEXT,
    balance NUMERIC DEFAULT 0,
    created_at TIMESTAMP DEFAULT NOW()
  );
`).catch(err => console.log("DB Error:", err));

// الكيبورد يلي تحت مثل ريبلت
const mainKeyboard = Markup.keyboard([
  ["💰 رصيدي", "📥 ايداع"],
  ["📤 سحب", "ℹ️ معلومات"]
]).resize();

bot.start(async (ctx) => {
  const userId = ctx.from.id;
  const username = ctx.from.username || ctx.from.first_name;

  await pool.query(
    "INSERT INTO users (id, username) VALUES ($1, $2) ON CONFLICT (id) DO NOTHING",
    [userId, username]
  );

  ctx.reply(`مرحبا ${username} 👋\nالبوت شغال على Render 100%`, mainKeyboard);
});

bot.hears("💰 رصيدي", async (ctx) => {
  const res = await pool.query("SELECT balance FROM users WHERE id = $1", [ctx.from.id]);
  const balance = res.rows[0]?.balance || 0;
  ctx.reply(`رصيدك الحالي: ${balance}$ 💵`);
});

bot.hears("📥 ايداع", (ctx) => {
  ctx.reply("ارسل المبلغ يلي بدك تودعه\nمثال: 50");
});

bot.hears("📤 سحب", (ctx) => {
  ctx.reply("ارسل المبلغ يلي بدك تسحبه\nمثال: 20");
});

bot.hears("ℹ️ معلومات", (ctx) => {
  ctx.reply("بوت alamaron على Render\nجميع المميزات شغالة ✅");
});

// لوحة الادمن
bot.command("admin", async (ctx) => {
  if (ctx.from.id.toString()!== process.env.ADMIN_ID) {
    return ctx.reply("انت مو ادمن ❌");
  }
  ctx.reply("👑 اهلا ادمن\nاوامر الادمن:\n/addbalance [id] [مبلغ]\nمثال: /addbalance 123456 100");
});

bot.command("addbalance", async (ctx) => {
  if (ctx.from.id.toString()!== process.env.ADMIN_ID) return;

  const args = ctx.message.text.split(" ");
  const userId = args[1];
  const amount = parseFloat(args[2]);

  if (!userId || isNaN(amount)) return ctx.reply("الاستخدام: /addbalance [id] [مبلغ]");

  await pool.query("UPDATE users SET balance = balance + $1 WHERE id = $2", [amount, userId]);
  ctx.reply(`تم اضافة ${amount}$ للمستخدم ${userId} ✅`);
});

// اضافة رصيد عن طريق كتابة الرقم
bot.on("text", async (ctx) => {
  const text = ctx.message.text;
  if (text.startsWith("/") || text.startsWith("💰") || text.startsWith("📥") || text.startsWith("📤") || text.startsWith("ℹ️")) return;

  const amount = parseFloat(text);
  if (!isNaN(amount) && amount > 0) {
    await pool.query("UPDATE users SET balance = balance + $1 WHERE id = $2", [amount, ctx.from.id]);
    const res = await pool.query("SELECT balance FROM users WHERE id = $1", [ctx.from.id]);
    ctx.reply(`تم اضافة ${amount}$ لرصيدك ✅\nرصيدك الجديد: ${res.rows[0].balance}$`);
  }
});

bot.launch().then(() => console.log("البوت اشتغل على Render مع قاعدة البيانات ✅"));

process.once("SIGINT", () => bot.stop("SIGINT"));
process.once("SIGTERM", () => bot.stop("SIGTERM"));
